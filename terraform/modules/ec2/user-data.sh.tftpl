#!/usr/bin/env bash

# EC2 user data runs once when the instance first boots.
# AWS limits EC2 user_data to 16 KB, unless you use S3 to save a larger file

set -euo pipefail
exec > >(tee -a /var/log/wordpress-bootstrap.log) 2>&1

INSTALL_MODE="${install_mode}"
SITE_TITLE="${site_title}"
SITE_ARCHIVE_BASE64="${site_archive}"
DB_NAME="${db_name}"
DB_USER="${db_username}"
DB_PASSWORD="${db_password}"
DB_HOST="${db_host}"
WP_ADMIN_USER="${wp_admin_user}"
WP_ADMIN_PASSWORD="${wp_admin_password}"
WP_ADMIN_EMAIL="${wp_admin_email}"
S3_BACKUP_BUCKET="${s3_backup_bucket_name}"
SITE_URL="http://$(curl -fsS http://169.254.169.254/latest/meta-data/public-hostname)"

echo "Starting WordPress bootstrap for $${SITE_TITLE}..."
apt-get update -y
apt-get install -y apache2 mysql-client unzip curl rsync php php-mysql php-curl php-gd php-mbstring php-xml php-xmlrpc php-soap php-intl php-zip

if [ "$${INSTALL_MODE}" = "rds" ] && [ -n "$${S3_BACKUP_BUCKET}" ]; then
  apt-get install -y awscli
fi

if [ "$${INSTALL_MODE}" = "local-db" ]; then
  apt-get install -y mariadb-server
  systemctl enable mariadb
  systemctl start mariadb
  mysql -e "CREATE DATABASE IF NOT EXISTS \`$${DB_NAME}\`;"
  mysql -e "CREATE USER IF NOT EXISTS '$${DB_USER}'@'localhost' IDENTIFIED BY '$${DB_PASSWORD}';"
  mysql -e "GRANT ALL PRIVILEGES ON \`$${DB_NAME}\`.* TO '$${DB_USER}'@'localhost';"
  mysql -e "FLUSH PRIVILEGES;"
fi

systemctl enable apache2
systemctl start apache2

cd /tmp
curl -fsSLO https://wordpress.org/latest.zip
unzip -q latest.zip
rm -f /var/www/html/index.html
rsync -a /tmp/wordpress/ /var/www/html/

cp /var/www/html/wp-config-sample.php /var/www/html/wp-config.php
sed -i "s/database_name_here/$${DB_NAME}/" /var/www/html/wp-config.php
sed -i "s/username_here/$${DB_USER}/" /var/www/html/wp-config.php
sed -i "s/password_here/$${DB_PASSWORD}/" /var/www/html/wp-config.php
sed -i "s/localhost/$${DB_HOST}/" /var/www/html/wp-config.php

curl -fsSLo /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar
chmod +x /usr/local/bin/wp
chown -R www-data:www-data /var/www/html/

if ! sudo -u www-data wp core is-installed --path=/var/www/html; then
  sudo -u www-data wp core install \
    --path=/var/www/html \
    --url="$${SITE_URL}" \
    --title="$${SITE_TITLE}" \
    --admin_user="$${WP_ADMIN_USER}" \
    --admin_password="$${WP_ADMIN_PASSWORD}" \
    --admin_email="$${WP_ADMIN_EMAIL}" \
    --skip-email
fi

HOME_ID="$(sudo -u www-data wp post create --path=/var/www/html --post_type=page --post_title='Home' --post_status=publish --porcelain)"
ABOUT_ID="$(sudo -u www-data wp post create --path=/var/www/html --post_type=page --post_title='About' --post_status=publish --porcelain)"
SERVICES_ID="$(sudo -u www-data wp post create --path=/var/www/html --post_type=page --post_title='Services' --post_status=publish --porcelain)"

sudo -u www-data wp post update "$${HOME_ID}" --path=/var/www/html --post_content="<h2>Welcome to $${SITE_TITLE}</h2><p>This WordPress site is hosted on AWS infrastructure created with Terraform.</p><p><a href='/demo/'>View the infrastructure demo</a>.</p>"
sudo -u www-data wp post update "$${ABOUT_ID}" --path=/var/www/html --post_content="<p>This site demonstrates repeatable WordPress hosting using AWS, Terraform, EC2, and either local MariaDB or RDS MySQL.</p>"
sudo -u www-data wp post update "$${SERVICES_ID}" --path=/var/www/html --post_content="<p>Example services include WordPress rehosting, infrastructure as code, AWS cost controls, backups, and hardening.</p>"
sudo -u www-data wp option update show_on_front page --path=/var/www/html
sudo -u www-data wp option update page_on_front "$${HOME_ID}" --path=/var/www/html
sudo -u www-data wp option update blogdescription "AWS WordPress Terraform platform" --path=/var/www/html

if ! sudo -u www-data wp menu list --path=/var/www/html --field=name | grep -Fxq "Primary Navigation"; then
  sudo -u www-data wp menu create "Primary Navigation" --path=/var/www/html
fi
sudo -u www-data wp menu item add-post "Primary Navigation" "$${HOME_ID}" --path=/var/www/html || true
sudo -u www-data wp menu item add-post "Primary Navigation" "$${ABOUT_ID}" --path=/var/www/html || true
sudo -u www-data wp menu item add-post "Primary Navigation" "$${SERVICES_ID}" --path=/var/www/html || true
sudo -u www-data wp menu item add-custom "Primary Navigation" "Infrastructure Demo" "$${SITE_URL}/demo/" --path=/var/www/html || true

mkdir -p /var/www/html/demo
if [ -n "$${SITE_ARCHIVE_BASE64}" ]; then
  printf '%s' "$${SITE_ARCHIVE_BASE64}" | base64 -d > /tmp/site.zip
  unzip -oq /tmp/site.zip -d /tmp/static-site
  if [ -f /tmp/static-site/index.html ]; then
    rsync -a /tmp/static-site/ /var/www/html/demo/
  else
    first_index="$(find /tmp/static-site -mindepth 2 -name index.html | head -n 1)"
    [ -n "$${first_index}" ] && rsync -a "$(dirname "$${first_index}")/" /var/www/html/demo/
  fi
fi

if [ ! -f /var/www/html/demo/index.html ]; then
  cat > /var/www/html/demo/index.html <<HTML
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>$${SITE_TITLE}</title><style>body{margin:0;font-family:system-ui;background:#f6f8fb;color:#172033}main{max-width:900px;margin:10vh auto;padding:24px}.panel{background:#fff;border:1px solid #d7deea;border-radius:8px;padding:24px;box-shadow:0 18px 50px #17203314}.badges{display:flex;gap:10px;flex-wrap:wrap}.badge{background:#e9f5ff;border-radius:999px;padding:8px 12px;font-weight:700}</style></head><body><main><section class="panel"><h1>$${SITE_TITLE}</h1><p>This demo was launched on AWS with Terraform. WordPress is available at <a href="/">/</a> and admin at <a href="/wp-admin/">/wp-admin/</a>.</p><div class="badges"><span class="badge">Terraform</span><span class="badge">AWS EC2</span><span class="badge">WordPress</span><span class="badge">$${INSTALL_MODE}</span></div></section></main></body></html>
HTML
fi

%{ if s3_backup_bucket_name != "" }
if [ "$${INSTALL_MODE}" = "rds" ] && [ -n "$${S3_BACKUP_BUCKET}" ]; then
  sudo -u www-data wp menu item add-custom "Primary Navigation" "RDS + S3 Lab" "$${SITE_URL}/demo/rds-lab.php" --path=/var/www/html || true
  cat > /var/www/html/demo/rds-lab.php <<'PHP'
<?php
require_once __DIR__ . '/../wp-load.php';
$bucket = '__S3_BUCKET_NAME__';
if (!is_user_logged_in() || !current_user_can('manage_options')) {
  wp_safe_redirect(wp_login_url('/demo/rds-lab.php'));
  exit;
}
global $wpdb;
$table = $wpdb->prefix . 'infra_demo_assets';
$wpdb->query("CREATE TABLE IF NOT EXISTS $table (id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,demo_note VARCHAR(255) NOT NULL,status VARCHAR(40) NOT NULL DEFAULT 'Planned',s3_uri TEXT NULL,created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,PRIMARY KEY(id)) ".$wpdb->get_charset_collate());
$msg = '';
$err = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  check_admin_referer('rds_s3_lab_action');
  $action = sanitize_text_field(wp_unslash($_POST['action'] ?? ''));
  $id = absint($_POST['row_id'] ?? 0);
  if ($action === 'add' || $action === 'update') {
    $data = ['demo_note' => sanitize_text_field(wp_unslash($_POST['demo_note'] ?? '')), 'status' => sanitize_text_field(wp_unslash($_POST['status'] ?? 'Planned'))];
    $action === 'add' ? $wpdb->insert($table, $data) : $wpdb->update($table, $data, ['id' => $id]);
    $msg = 'Database row saved in RDS.';
  } elseif ($action === 'delete') {
    $wpdb->delete($table, ['id' => $id]);
    $msg = 'Database row deleted from RDS.';
  } elseif ($action === 'upload' && !empty($_FILES['demo_file']['tmp_name'])) {
    $name = sanitize_file_name($_FILES['demo_file']['name']);
    $tmp = '/tmp/wp-rds-demo-' . uniqid('', true) . '-' . $name;
    if (move_uploaded_file($_FILES['demo_file']['tmp_name'], $tmp)) {
      $uri = 's3://' . $bucket . '/demo-uploads/' . gmdate('Ymd-His') . '-' . $name;
      $out = shell_exec('aws s3 cp ' . escapeshellarg($tmp) . ' ' . escapeshellarg($uri) . ' --only-show-errors 2>&1');
      unlink($tmp);
      if ($out === null || trim($out) === '') {
        $wpdb->update($table, ['s3_uri' => $uri], ['id' => $id]);
        $msg = 'File uploaded to S3 and linked to the RDS row.';
      } else {
        $err = trim($out);
      }
    }
  }
}
$rows = $wpdb->get_results("SELECT * FROM $table ORDER BY id DESC LIMIT 25");
?>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RDS + S3 Lab</title><style>body{font-family:system-ui;margin:0;background:#f6f8fb;color:#172033}main{max-width:1100px;margin:auto;padding:32px}.panel{background:#fff;border:1px solid #d7deea;border-radius:8px;margin:16px 0;padding:20px}input,select,button{font:inherit;padding:9px;margin:4px 0}button{background:#195bb8;color:#fff;border:0;border-radius:6px;font-weight:700}table{width:100%;border-collapse:collapse}td,th{border-bottom:1px solid #d7deea;padding:8px;text-align:left}.ok{background:#edfdf5;padding:10px}.err{background:#fff1f0;padding:10px}</style></head><body><main><h1>RDS + S3 Lab</h1><p>Rows save to RDS. Uploads copy to S3 bucket: <strong><?php echo esc_html($bucket); ?></strong></p><?php if($msg): ?><p class="ok"><?php echo esc_html($msg); ?></p><?php endif; ?><?php if($err): ?><p class="err"><?php echo esc_html($err); ?></p><?php endif; ?><form class="panel" method="post"><?php wp_nonce_field('rds_s3_lab_action'); ?><input type="hidden" name="action" value="add"><input name="demo_note" required value="Migration checklist item"><select name="status"><option>Planned</option><option>In Progress</option><option>Complete</option></select><button>Add RDS Row</button></form><section class="panel"><table><tr><th>ID</th><th>Note</th><th>Status</th><th>S3 URI</th><th>Actions</th></tr><?php foreach($rows as $row): ?><tr><td><?php echo esc_html($row->id); ?></td><td><form id="u<?php echo esc_attr($row->id); ?>" method="post"><?php wp_nonce_field('rds_s3_lab_action'); ?><input type="hidden" name="action" value="update"><input type="hidden" name="row_id" value="<?php echo esc_attr($row->id); ?>"><input name="demo_note" value="<?php echo esc_attr($row->demo_note); ?>"></form></td><td><select form="u<?php echo esc_attr($row->id); ?>" name="status"><option <?php selected($row->status,'Planned'); ?>>Planned</option><option <?php selected($row->status,'In Progress'); ?>>In Progress</option><option <?php selected($row->status,'Complete'); ?>>Complete</option></select></td><td><?php echo esc_html($row->s3_uri ?: 'No upload'); ?></td><td><button form="u<?php echo esc_attr($row->id); ?>">Update</button><form method="post" enctype="multipart/form-data"><?php wp_nonce_field('rds_s3_lab_action'); ?><input type="hidden" name="action" value="upload"><input type="hidden" name="row_id" value="<?php echo esc_attr($row->id); ?>"><input type="file" name="demo_file" required><button>Upload</button></form><form method="post"><?php wp_nonce_field('rds_s3_lab_action'); ?><input type="hidden" name="action" value="delete"><input type="hidden" name="row_id" value="<?php echo esc_attr($row->id); ?>"><button>Delete</button></form></td></tr><?php endforeach; ?></table></section></main></body></html>
PHP
  sed -i "s/__S3_BUCKET_NAME__/$${S3_BACKUP_BUCKET}/g" /var/www/html/demo/rds-lab.php
fi
%{ endif }

chown -R www-data:www-data /var/www/html/
find /var/www/html/ -type d -exec chmod 755 {} \;
find /var/www/html/ -type f -exec chmod 644 {} \;
systemctl restart apache2

echo "WordPress is installed at $${SITE_URL}."
echo "Static infrastructure demo is available at $${SITE_URL}/demo/."
echo "WordPress admin is available at $${SITE_URL}/wp-admin/ with user $${WP_ADMIN_USER}."
