# Example values for the wp-rds environment.
# Copy this file to terraform.tfvars for local use, then replace placeholders.
# Do not commit terraform.tfvars or any real secrets.

aws_region = "us-east-1"

project_name = "wordpress-wp-rds"

vpc_cidr = "10.40.0.0/16"

# Replace with your own public IP range before using SSH.
# Example format: "203.0.113.10/32"
allowed_ssh_cidr = "0.0.0.0/0"

instance_type = "t3.micro"

# Must match an existing EC2 key pair in the selected AWS region.
key_name = "replace-with-your-key-pair"

site_title = "Cloud WordPress Demo"

# Created automatically by scripts/start-demo.sh.
# The zip should contain index.html at the root.
site_archive_path = "../../../.generated/wp-rds-cloud-wordpress-demo-site.zip"

db_name = "wordpress"

# RDS master usernames must use letters/numbers only, start with a letter,
# and be 16 characters or fewer.
db_username = "wpadmin"

# S3 bucket names must be globally unique.
backup_bucket_name = "replace-with-globally-unique-wp-rds-backup-bucket"

# Provide this value through an uncommitted terraform.tfvars file,
# an environment variable, or a secrets manager. Do not put real passwords here.
# db_password = "replace-with-a-secure-local-only-value"

# This is the username you use at /wp-admin/.
wp_admin_user = "demo_admin"

wp_admin_email = "admin@example.com"

# Keep this different from db_password.
# wp_admin_password = "replace-with-a-separate-secure-local-only-value"
